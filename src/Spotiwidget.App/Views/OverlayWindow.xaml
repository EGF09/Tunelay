<Window x:Class="Spotiwidget.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spotiwidget" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Focusable="False" UseLayoutRounding="True">
    <Window.Resources>
        <!-- Flat round icon button. -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="17" Background="#00FFFFFF" RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover: background fades in/out instead of snapping. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Bg" To="#26FFFFFF" Duration="0:0:0.12"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Bg" To="#00FFFFFF" Duration="0:0:0.18"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <!-- Press: shrink slightly. -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel x:Name="CardStack" Margin="12" Width="300">
        <Border x:Name="ToastBox" Background="{StaticResource CardBrush}" CornerRadius="10"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                Padding="12,8" Margin="0,6" Visibility="Collapsed">
            <TextBlock Text="{Binding Toast}" Foreground="{StaticResource TextBrush}"
                       TextWrapping="Wrap" FontSize="12" />
        </Border>

        <Grid x:Name="CardHost">
        <Border x:Name="Card" Background="{StaticResource CardBrush}" CornerRadius="14"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="10,10,10,8">
            <StackPanel>
                <!-- Track -->
                <Grid x:Name="TrackRow">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="8" Background="#22FFFFFF" ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                       Foreground="{StaticResource SubtleTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding ImageUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}"
                                   FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Foreground="{StaticResource SubtleTextBrush}" FontSize="12"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                            <Run Text="{Binding Artist, Mode=OneWay}" />
                            <Run Text="{Binding MoodSuffix, Mode=OneWay}" Foreground="{Binding MoodBrush, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- Controls -->
                <StackPanel x:Name="Controls" Margin="0,8,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Style="{StaticResource IconButton}" Content="&#xE892;" ToolTip="Önceki" Click="OnPrevious" />
                        <Button Style="{StaticResource IconButton}" Content="{Binding PlayGlyph}" FontSize="16"
                                ToolTip="Oynat / Duraklat" Click="OnPlayPause" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="Sonraki" Click="OnNext" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="LikeButton" Style="{StaticResource IconButton}" Content="{Binding LikeGlyph}"
                                Foreground="{Binding LikeBrush}" ToolTip="Beğenilen Şarkılar'a ekle / çıkar" Click="OnLike" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE710;"
                                ToolTip="Aktif modun çalma listesine ekle" Click="OnAddToMood" />
                    </StackPanel>
                </Grid>

                <!-- Volume -->
                <Grid Margin="8,6,4,0" ToolTip="Ses (kart üzerinde fare tekerleği de çalışır)">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center" />
                    <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource FlatSlider}" Margin="10,0"
                            Minimum="0" Maximum="100" IsMoveToPointEnabled="True" Focusable="False"
                            Value="{Binding Volume, Mode=OneWay, TargetNullValue=0}"
                            PreviewMouseLeftButtonUp="OnVolumeCommitted" />
                    <TextBlock Grid.Column="2" Text="{Binding VolumeText}" Foreground="{StaticResource SubtleTextBrush}"
                               FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
                </StackPanel>

                <!-- Moods: only in a fullscreen app (the desktop dock is hidden there) or when the dock is off -->
                <WrapPanel x:Name="MoodRow" Margin="0,8,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Border>
        <!-- Move mode: dashed frame; the whole card becomes a drag handle. -->
        <Rectangle x:Name="MoveFrame" RadiusX="14" RadiusY="14" Stroke="{StaticResource AccentBrush}"
                   StrokeThickness="2" StrokeDashArray="4 3" Fill="#01000000" Cursor="SizeAll"
                   Visibility="Collapsed" ToolTip="Sürükleyerek taşıyın" />
        </Grid>
    </StackPanel>
</Window>
