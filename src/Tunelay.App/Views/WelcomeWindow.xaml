<Window x:Class="Tunelay.App.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tunelay'e hoş geldiniz" Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#FF141414" Foreground="{StaticResource TextBrush}"
        FontSize="13" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#FF0B0B0B" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="19" />
        </Style>
        <Style x:Key="Option" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,14,0,0" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="28,22,28,22">
        <StackPanel x:Name="IntroPage">
            <TextBlock Style="{StaticResource Title}" Text="Tunelay'e hoş geldiniz" />
            <TextBlock Style="{StaticResource Body}"
                       Text="Spotify masaüstü uygulamanızı kart ve kısayollarla yönetir. Spotify kapalıysa Oynat'a basınca arkada açar." />

            <Border Style="{StaticResource Option}">
                <StackPanel>
                    <TextBlock Text="Giriş yapmadan" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Body}" Margin="0,4,0,12"
                               Text="Şarkı ve kapak, oynat, atla, karışık, tekrar. Ses, Spotify çalarken ayarlanır." />
                    <Button x:Name="UseNowButton" Style="{StaticResource Primary}" Content="Hemen kullan"
                            HorizontalAlignment="Left" Click="OnUseNow" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Option}">
                <StackPanel>
                    <TextBlock Text="Hesapla" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Body}" Margin="0,4,0,12"
                               Text="Ayrıca ruh hali listeleri, ♡ beğenme ve ＋ listeye ekleme. Spotify Premium ve birkaç dakikalık tek seferlik kurulum ister. Sonra da bağlayabilirsiniz." />
                    <Button Content="Hesabımı bağla" HorizontalAlignment="Left" Click="OnConnectAccount" />
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel x:Name="WizardPage" Visibility="Collapsed">
            <TextBlock x:Name="StepLabel" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,0,0,6" />

            <StackPanel x:Name="Step1">
                <TextBlock Style="{StaticResource Title}" Text="Spotify panelinde uygulama oluşturun" />
                <TextBlock Style="{StaticResource Body}"
                           Text="Paneli açıp Spotify hesabınızla girin, Create app'e basın. Ad ve açıklama serbesttir, API olarak Web API'yi seçin. Formu kaydetmeden sonraki adıma geçin." />
                <Button Content="Paneli aç" HorizontalAlignment="Left" Margin="0,14,0,0" Click="OnOpenDashboard" />
            </StackPanel>

            <StackPanel x:Name="Step2" Visibility="Collapsed">
                <TextBlock Style="{StaticResource Title}" Text="Redirect URI'yi yapıştırın" />
                <TextBlock Style="{StaticResource Body}"
                           Text="Bu adresi kopyalayın, formdaki Redirect URIs alanına yapıştırın, Add'e, sonra Save'e basın. Adres birebir aynı olmalı." />
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="RedirectBox" IsReadOnly="True" />
                    <Button x:Name="CopyButton" Grid.Column="1" Content="Kopyala" Margin="8,0,0,0" Click="OnCopy" />
                </Grid>
            </StackPanel>

            <StackPanel x:Name="Step3" Visibility="Collapsed">
                <TextBlock Style="{StaticResource Title}" Text="Client ID'yi yapıştırın" />
                <TextBlock Style="{StaticResource Body}"
                           Text="Client ID, uygulamanızın Settings sayfasındadır. Client secret gerekmez, paylaşmayın. Bağlan'a basınca tarayıcıda Spotify girişi açılır." />
                <TextBox x:Name="ClientIdBox" Margin="0,14,0,0" TextChanged="OnClientIdChanged" />
                <TextBlock x:Name="ClientIdHint" Style="{StaticResource Body}" FontSize="12" Margin="0,6,0,0" />
                <TextBlock Style="{StaticResource Body}" FontSize="12" Margin="0,10,0,0"
                           Text="Uygulama başka birinin hesabındaysa, o kişi sizi User Management bölümüne eklemeli." />
            </StackPanel>

            <TextBlock x:Name="Status" Style="{StaticResource Body}" Margin="0,14,0,0" />
            <DockPanel Margin="0,12,0,0" LastChildFill="False">
                <Button x:Name="BackButton" Content="Geri" Click="OnBack" />
                <Button x:Name="NextButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Devam" Click="OnNext" />
            </DockPanel>
        </StackPanel>
    </StackPanel>
</Window>
