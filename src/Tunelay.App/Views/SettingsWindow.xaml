<Window x:Class="Tunelay.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tunelay Ayarları" Width="780" Height="620" MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="#FF141414" Foreground="{StaticResource TextBrush}"
        FontSize="13" UseLayoutRounding="True">
    <Window.Resources>
        <!-- ===== Text ===== -->
        <Style TargetType="TextBlock" x:Key="Title">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Section">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="17" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <!-- ===== Panel card ===== -->
        <Style TargetType="Border" x:Key="Panel">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <!-- ===== Buttons ===== -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#FF0B0B0B" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3BE477" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SmallButton}">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        </Style>

        <!-- ===== TextBox ===== -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{StaticResource SurfaceBrush}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF555555" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== ComboBox ===== -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="3,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#331ED760" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="MaxDropDownHeight" Value="300" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press" Cursor="Hand"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                                                BorderThickness="1" CornerRadius="6">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                                  Data="M0,0 L4,4 L8,0" Stroke="{StaticResource SubtleTextBrush}" StrokeThickness="1.5" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF555555" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="10,0,26,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#FF232323" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                        CornerRadius="6" Margin="0,4,0,0" Padding="0,3"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Thin scrollbar ===== -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="4" Background="#44FFFFFF" Margin="1" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#FF262626" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="Padding" Value="8,5" />
        </Style>

        <!-- ===== Navigation ===== -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Margin="0,2">
                            <Border x:Name="Bd" CornerRadius="8" Background="Transparent" Padding="12,9">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="Bar" Width="3" CornerRadius="2" Margin="0,9" HorizontalAlignment="Left"
                                    Background="{StaticResource AccentBrush}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2Brush}" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Color dropdown items are "#RRGGBB" strings shown as round swatches. -->
        <DataTemplate x:Key="SwatchTemplate">
            <Border Width="16" Height="16" CornerRadius="8" Background="{Binding}" />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Left: navigation ===== -->
        <Border Grid.RowSpan="2" Background="#FF101010" Padding="12,18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,20">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="♪" FontSize="17" Foreground="#FF0B0B0B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Tunelay" FontWeight="SemiBold" />
                        <TextBlock Text="Ayarlar" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" />
                    </StackPanel>
                </StackPanel>
                <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0" Padding="0"
                         ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="OnNavChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBoxItem Tag="SpotifySection">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" Width="22" VerticalAlignment="Center" />
                            <TextBlock Text="Spotify" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="MoodsSection">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE790;" FontFamily="{StaticResource IconFont}" Width="22" VerticalAlignment="Center" />
                            <TextBlock Text="Ruh halleri" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="LookSection">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE771;" FontFamily="{StaticResource IconFont}" Width="22" VerticalAlignment="Center" />
                            <TextBlock Text="Görünüm" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="KeysSection">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" Width="22" VerticalAlignment="Center" />
                            <TextBlock Text="Kısayollar" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===== Right: sections ===== -->
        <ScrollViewer x:Name="Scroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="28,22,28,12">

                <!-- Spotify -->
                <StackPanel x:Name="SpotifySection">
                    <TextBlock Style="{StaticResource Title}" Text="Spotify" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,16"
                               Text="Oynat, atla, karışık ve tekrar hesapsız çalışır. Ruh hali listeleri, ♡ ve ＋ için hesap bağlayın." />

                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <TextBlock Style="{StaticResource Section}" Text="Bağlantı" Margin="0" VerticalAlignment="Center" />
                                <Border x:Name="StatusBadge" HorizontalAlignment="Right" CornerRadius="10" Padding="10,3" Background="#22FFFFFF">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource SubtleTextBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="StatusText" Text="Bağlı değil" FontSize="12" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ConnectButton" Style="{StaticResource PrimaryButton}" Content="Hesap bağla…" Click="OnConnect" />
                                <Button x:Name="RefreshButton" Content="İzinleri yenile" Click="OnRefreshPermissions" Visibility="Collapsed"
                                        ToolTip="Tarayıcıda yeniden onaylarsınız. Listeleriniz ve ayarlarınız kalır." />
                                <Button x:Name="DisconnectButton" Content="Bağlantıyı kes…" Foreground="{StaticResource DangerBrush}"
                                        Click="OnDisconnect" Visibility="Collapsed" />
                            </StackPanel>
                            <TextBlock x:Name="AuthStatus" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Hesapla kontrol Spotify Premium gerektirir. ♡ (beğenme) çalışmıyorsa İzinleri yenile'ye basın." />
                </StackPanel>

                <!-- Moods -->
                <StackPanel x:Name="MoodsSection" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Title}" Text="Ruh halleri" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,16"
                               Text="Renk, isim ve çalma listesi seçin; düğmeye basınca liste karışık çalar. Oklarla sıralayın: sıra panelde ve Ctrl+Alt+M geçişinde kullanılır." />
                    <Border Style="{StaticResource Panel}" Padding="14,12">
                        <StackPanel>
                            <StackPanel x:Name="MoodList" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="＋  Ruh hali ekle" Click="OnAddMood" />
                                <Button Content="Listeleri yenile" Click="OnRefreshPlaylists" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Look -->
                <StackPanel x:Name="LookSection" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Title}" Text="Görünüm" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,16"
                               Text="Değişiklikler kartta hemen önizlenir; kaydetmezseniz geri alınır." />

                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Section}" Text="Şarkı kartı" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="48" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="Ekran köşesi" />
                                <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                                    <ComboBox x:Name="CornerBox" Width="160" SelectionChanged="OnPreviewChanged" />
                                    <Button x:Name="ResetPositionsButton" Content="Köşeye geri al" Margin="8,0,0,0" Click="OnResetPositions"
                                            ToolTip="Taşıma modunda sürüklediğiniz kart ve panel konumlarını sıfırlar" />
                                </StackPanel>
                                <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Boşta opaklık" Margin="0,16,0,0" />
                                <Slider x:Name="IdleOpacitySlider" Grid.Row="1" Grid.Column="1" Style="{StaticResource FlatSlider}" Margin="0,16,12,0"
                                        Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="5"
                                        ToolTip="Kart tıklamaları geçirirken (yalnızca şarkı bilgisi). %0 = tamamen görünmez" />
                                <TextBlock x:Name="IdleOpacityText" Grid.Row="1" Grid.Column="2" Style="{StaticResource Label}" Margin="0,16,0,0" TextAlignment="Right" />
                                <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Etkileşim opaklığı" Margin="0,12,0,0" />
                                <Slider x:Name="ActiveOpacitySlider" Grid.Row="2" Grid.Column="1" Style="{StaticResource FlatSlider}" Margin="0,12,12,0"
                                        Minimum="10" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="5"
                                        ToolTip="Etkileşim tuşuyla açıldığında" />
                                <TextBlock x:Name="ActiveOpacityText" Grid.Row="2" Grid.Column="2" Style="{StaticResource Label}" Margin="0,12,0,0" TextAlignment="Right" />
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0"
                                       Text="Kart normalde şeffaf durur ve tıklamaları geçirir; etkileşim tuşuyla düğmeler açılır. Taşımak için Ctrl+Alt+D veya tepsi menüsü → Taşıma modu." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Section}" Text="Genel" />
                            <CheckBox x:Name="ShowMoodDockBox" Content="Ruh hali düğmelerini masaüstünde göster" />
                            <CheckBox x:Name="AnimationsBox" Content="Animasyonlar" Margin="0,12,0,0" Click="OnPreviewChanged" />
                            <TextBlock Style="{StaticResource Hint}" Margin="50,4,0,0"
                                       Text="Kısa geçişler (en fazla 250 ms, hiçbiri sürekli dönmez). Windows animasyonları kapalıyken de kapanır." />
                            <Grid Margin="50,12,0,0" IsEnabled="{Binding IsChecked, ElementName=AnimationsBox}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.45" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <TextBlock Style="{StaticResource Label}" Text="Oyunda animasyonlar" />
                                <ComboBox x:Name="GameAnimationsBox" Grid.Column="1" Width="200" HorizontalAlignment="Left"
                                          SelectionChanged="OnPreviewChanged" />
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}" Margin="50,6,0,0"
                                       Text="Tam ekran oyunlarda seçtiğiniz seviyede çalışır. Şarkı değişince kart birkaç saniye belirginleşir (animasyonlar kapalıyken de)." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Section}" Text="Windows" />
                            <CheckBox x:Name="StartupToggle" Content="Windows ile başlat" />
                            <TextBlock Style="{StaticResource Hint}" Margin="50,4,0,0"
                                       Text="Kaydet'i beklemeden uygulanır. Pencere açmadan, odak almadan başlar." />
                            <TextBlock x:Name="StartupHint" Style="{StaticResource Hint}" Margin="50,6,0,0" Foreground="{StaticResource TextBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Keys -->
                <StackPanel x:Name="KeysSection" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Title}" Text="Kısayollar" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,16"
                               Text="Kutuya tıklayıp yeni kombinasyona basın. Ctrl/Alt/Shift/Win ile birlikte ya da tek başına F1–F24, Pause, Scroll Lock, Insert. Backspace siler, Esc vazgeçer. (Dizüstü Fn tuşu Windows'a ulaşmadığı için seçilemez.)" />
                    <Border Style="{StaticResource Panel}" Padding="14,10">
                        <Grid x:Name="HotkeyGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="230" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ===== Bottom bar ===== -->
        <Border Grid.Row="1" Grid.Column="1" BorderBrush="#FF242424" BorderThickness="0,1,0,0" Padding="28,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="İptal" Click="OnCancel" />
                    <Button Content="Kaydet" Style="{StaticResource PrimaryButton}" Margin="0" Click="OnSave" />
                </StackPanel>
                <TextBlock x:Name="FooterStatus" VerticalAlignment="Center" Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" FontSize="12" Margin="0,0,12,0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
