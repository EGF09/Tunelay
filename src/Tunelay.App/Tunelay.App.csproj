<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Tunelay.Core\Tunelay.Core.csproj" />
    <ProjectReference Include="..\Tunelay.Native\Tunelay.Native.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Spotify's official white logo and icon, unmodified, from developer.spotify.com/documentation/design -->
    <Resource Include="Assets\SpotifyLogo.png" />
    <Resource Include="Assets\SpotifyIcon.png" />
    <!-- Tunelay's own logo; Tunelay.svg is the master drawing. -->
    <Resource Include="Assets\Tunelay.ico" />
    <Resource Include="Assets\Tunelay.png" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Tunelay</AssemblyName>
    <RootNamespace>Tunelay.App</RootNamespace>
    <Product>Tunelay</Product>
    <!-- Also the taskbar and title bar icon: WPF takes it from the exe. -->
    <ApplicationIcon>Assets\Tunelay.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
